{
  "name": "twitch-overlay",
  "version": "1.1.0",
  "description": "Twitch Transparent Chat Overlay",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "keywords": [],
  "author": "BuXaLo",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "socks": "^2.8.0"
  },
  "build": {
    "appId": "com.twitch.overlay",
    "productName": "TwitchOverlay",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "icon": "icon.ico",
      "signAndEditExecutable": false
    },
    "forceCodeSigning": false,
    "files": [
      "main.js",
      "preload.js",
      "twitch.js",
      "emotes.js",
      "locales.js",
      "index.html",
      "icon.ico",
      "node_modules/**/*"
    ]
  }
}
