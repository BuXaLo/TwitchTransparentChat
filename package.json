{
  "name": "twitch-overlay",
  "version": "1.5.1",
  "description": "Twitch Transparent Chat Overlay",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable",
    "dist:nsis": "electron-builder --win nsis",
    "test": "node --test",
    "check:syntax": "node --check main.js && node --check preload.js && node --check config.js && node --check twitch.js && node --check emotes.js && node --check widget-server.js && node --check locales.js && node --check updater.js && node --check chat-view.js && node --check settings/settings.js && node --check settings/preview.js && node --check settings/presets.js && node --check settings/images.js"
  },
  "keywords": [],
  "author": "BuXaLo",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.7",
    "socks": "^2.8.0"
  },
  "build": {
    "appId": "com.twitch.overlay",
    "productName": "TwitchOverlay",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "BuXaLo",
        "repo": "TwitchTransparentChat"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.ico",
      "legalTrademarks": "BuXaLo",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TwitchOverlay",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "unpackDirName": true,
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "forceCodeSigning": false,
    "files": [
      "main.js",
      "preload.js",
      "twitch.js",
      "emotes.js",
      "locales.js",
      "updater.js",
      "index.html",
      "settings.html",
      "settings.css",
      "settings/settings.js",
      "settings/preview.js",
      "settings/presets.js",
      "settings/images.js",
      "widget.html",
      "chat.css",
      "chat-view.js",
      "config.js",
      "widget-server.js",
      "fonts.css",
      "fonts/**",
      "assets/**",
      "icon.ico",
      "node_modules/**/*"
    ]
  }
}
