{
  "name": "twitch-overlay",
  "version": "1.0.0",
  "description": "Twitch Transparent Chat Overlay for Games & Streaming",
  "main": "main.js",
  "author": "Streamer",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "socks": "^2.8.0"
  },
  "build": {
    "appId": "com.twitch.overlay",
    "productName": "TwitchOverlay",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "forceCodeSigning": false,
    "files": [
      "main.js",
      "preload.js",
      "twitch.js",
      "index.html",
      "node_modules/**/*"
    ]
  }
}